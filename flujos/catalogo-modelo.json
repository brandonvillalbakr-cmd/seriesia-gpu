  "5": {"class_type": "VAELoader", "inputs": {"vae_name": "qwen_image_vae.safetensors"}},
  "20": {"class_type": "LoadImage", "_meta": {"title": "Foto 1 – Prenda puesta"}, "inputs": {"image": "{{REFERENCIA_1}}"}},
  "21": {"class_type": "LoadImage", "_si": "referencia_2", "_meta": {"title": "Foto 2 – Modelo nueva (opcional)"}, "inputs": {"image": "{{REFERENCIA_2}}"}},
  "22": {"class_type": "ImageScale", "_meta": {"title": "Ajustar la foto 1 al tamaño de salida"}, "inputs": {"image": ["20", 0], "upscale_method": "lanczos", "width": "{{ANCHO}}", "height": "{{ALTO}}", "crop": "center"}},
  "6": {"class_type": "TextEncodeQwenImageEditPlus", "_meta": {"title": "Instrucción"}, "inputs": {"clip": ["4", 0], "vae": ["5", 0], "prompt": "{{PROMPT}}", "image1": ["22", 0], "image2": ["21", 0]}},
  "7": {"class_type": "TextEncodeQwenImageEditPlus", "_meta": {"title": "Negativo"}, "inputs": {"clip": ["4", 0], "vae": ["5", 0], "prompt": "{{PROMPT_NEGATIVO}}", "image1": ["22", 0], "image2": ["21", 0]}},
  "8": {"class_type": "FluxKontextMultiReferenceLatentMethod", "inputs": {"conditioning": ["6", 0], "reference_latents_method": "index_timestep_zero"}},
  "9": {"class_type": "FluxKontextMultiReferenceLatentMethod", "inputs": {"conditioning": ["7", 0], "reference_latents_method": "index_timestep_zero"}},
  "10": {"class_type": "EmptySD3LatentImage", "inputs": {"width": "{{ANCHO}}", "height": "{{ALTO}}", "batch_size": 1}},
  "11": {"class_type": "KSampler", "inputs": {
    "model": {"_si": "lightning", "entonces": ["14", 0], "si_no": ["3", 0]},
    "seed": "{{SEMILLA}}",
    "steps": {"_si": "lightning", "entonces": 4, "si_no": 20},
    "cfg": {"_si": "lightning", "entonces": 1.0, "si_no": 4.0},
    "sampler_name": "euler", "scheduler": "simple",
    "positive": ["8", 0], "negative": ["9", 0], "latent_image": ["10", 0], "denoise": 1.0}},
  "12": {"class_type": "VAEDecode", "inputs": {"samples": ["11", 0], "vae": ["5", 0]}},
  "13": {"class_type": "SaveImage", "inputs": {"images": ["12", 0], "filename_prefix": "{{PREFIJO_SALIDA}}"}}
