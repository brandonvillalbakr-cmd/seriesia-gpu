  "3": {"class_type": "CFGNorm", "inputs": {"model": ["2", 0], "strength": 1.0, "pre_cfg": false}},
  "14": {"class_type": "LoraLoaderModelOnly", "_si": "lightning", "_meta": {"title": "LoRA Lightning 4 pasos (solo calidad rápida)"}, "inputs": {"model": ["3", 0], "lora_name": "Qwen-Image-Edit-2511-Lightning-4steps-V1.0-bf16.safetensors", "strength_model": 1.0}},
