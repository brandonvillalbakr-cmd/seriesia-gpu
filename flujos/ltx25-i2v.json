    "nodos_requeridos": ["UNETLoader", "CLIPLoader", "VAELoader", "LatentUpscaleModelLoader", "CLIPTextEncode", "LTXVConditioning", "LoadImage", "ImageScale", "LTXVPreprocess", "EmptyLTXVLatentVideo", "LTXVImgToVideoInplace", "LTXVEmptyLatentAudio", "LoadAudio", "TrimAudioDuration", "LTXVAudioVAEEncode", "SolidMask", "SetLatentNoiseMask", "LTXVConcatAVLatent", "RandomNoise", "KSamplerSelect", "ManualSigmas", "LTXVDualCFGGuider", "SamplerCustomAdvanced", "LTXVSeparateAVLatent", "LTXVLatentUpsampler", "VAEDecodeTiled", "LTXVAudioVAEDecode", "CreateVideo", "SaveVideo"],
    "nodos_personalizados": "ninguno (todo nativo de ComfyUI; no hace falta Lightricks/ComfyUI-LTXVideo para este flujo)",
    "modelos": [
      {"archivo": "ltx-2.5-22b-distilled-transformer-comfy-int8-convrot.safetensors", "carpeta": "diffusion_models", "repo": "Lightricks/LTX-2.5", "ruta": "diffusion_models/ltx-2.5-22b-distilled-transformer-comfy-int8-convrot.safetensors", "gb": 21.5},
      {"archivo": "gemma4-12b-with-proj-ltx-2.5-comfy-int8-convrot.safetensors", "carpeta": "text_encoders", "repo": "Lightricks/LTX-2.5", "ruta": "text_encoders/gemma4-12b-with-proj-ltx-2.5-comfy-int8-convrot.safetensors", "gb": 15.37},
      {"archivo": "ltx-2.5-video-vae-bf16.safetensors", "carpeta": "vae", "repo": "Lightricks/LTX-2.5", "ruta": "vae/ltx-2.5-video-vae-bf16.safetensors", "gb": 1.47},
      {"archivo": "ltx-2.5-audio-vae-bf16.safetensors", "carpeta": "vae", "repo": "Lightricks/LTX-2.5", "ruta": "vae/ltx-2.5-audio-vae-bf16.safetensors", "gb": 0.36},
      {"archivo": "ltx-2.5-latent-spatial-upscaler-x2-bf16-1.0.safetensors", "carpeta": "latent_upscale_models", "repo": "Lightricks/LTX-2.5", "ruta": "latent_upscale_models/ltx-2.5-latent-spatial-upscaler-x2-bf16-1.0.safetensors", "gb": 1.0}
    ],
    "carpetas_de_modelos": {
      "ltx-2.5-22b-distilled-transformer-comfy-int8-convrot.safetensors": "diffusion_models",
      "gemma4-12b-with-proj-ltx-2.5-comfy-int8-convrot.safetensors": "text_encoders",
      "ltx-2.5-video-vae-bf16.safetensors": "vae",
      "ltx-2.5-audio-vae-bf16.safetensors": "vae",
      "ltx-2.5-latent-spatial-upscaler-x2-bf16-1.0.safetensors": "latent_upscale_models"
    },
    "parametros": "Etapa 1: 8 sigmas manuales, euler_ancestral, cfg video/audio 1/1, imagen con fuerza 0,7 a media resolución. Etapa 2: subida x2 del latente, imagen con fuerza 1, sigmas 0.85/0.725/0.4219/0. fps 24 por defecto; frames 8n+1 (121 = 5 s); lados múltiplo de 64 (para que la media resolución sea múltiplo de 32): 720x1280 se vuelve 704x1280.",
    "vram_aproximada": "Lightricks dice 16 GB; realista 32–48 GB (docs/10 sección 1.3). Modelo 21,5 GB + codificador de texto 15,4 GB.",
    "prompt_negativo_defecto": "pc game, console game, video game, cartoon, childish, ugly",
    "_TODO": [
      "La plantilla oficial redimensiona la imagen con ResizeImageMaskNode ('scale longer dimension', 1536); aquí se usa ImageScale (núcleo) al tamaño exacto con recorte al centro. Revisar el encuadre en la prueba.",
      "La plantilla trae un 'mejorador de prompt' opcional (TextGenerateLTX2Prompt + gemma4_e2b_it_int8_convrot) apagado por defecto; no se incluye.",
      "Audio de referencia: se copió el patrón de la plantilla de LTX-2.3 ia2v; no hay plantilla ia2v publicada para LTX-2.5. Verificar sincronía de labios en la prueba.",
      "Confirmar en la primera corrida la clave 'format.codec' de SaveVideo (formato DynamicCombo de la API).",
      "int8 convrot usa los núcleos de comfy-kitchen; confirmar velocidad en H100/A100 (en Blackwell existe además la variante nvfp4)."
