  "1": {"class_type": "UNETLoader", "inputs": {"unet_name": "ltx-2.5-22b-distilled-transformer-comfy-int8-convrot.safetensors", "weight_dtype": "default"}},
  "2": {"class_type": "CLIPLoader", "inputs": {"clip_name": "gemma4-12b-with-proj-ltx-2.5-comfy-int8-convrot.safetensors", "type": "ltxv", "device": "default"}},
  "3": {"class_type": "VAELoader", "_meta": {"title": "VAE de video"}, "inputs": {"vae_name": "ltx-2.5-video-vae-bf16.safetensors"}},
  "4": {"class_type": "VAELoader", "_meta": {"title": "VAE de audio"}, "inputs": {"vae_name": "ltx-2.5-audio-vae-bf16.safetensors"}},
  "5": {"class_type": "LatentUpscaleModelLoader", "inputs": {"model_name": "ltx-2.5-latent-spatial-upscaler-x2-bf16-1.0.safetensors"}},
  "6": {"class_type": "CLIPTextEncode", "_meta": {"title": "Prompt"}, "inputs": {"clip": ["2", 0], "text": "{{PROMPT}}"}},
  "7": {"class_type": "CLIPTextEncode", "_meta": {"title": "Prompt negativo"}, "inputs": {"clip": ["2", 0], "text": "{{PROMPT_NEGATIVO}}"}},
  "8": {"class_type": "LTXVConditioning", "inputs": {"positive": ["6", 0], "negative": ["7", 0], "frame_rate": "{{FPS}}"}},
  "9": {"class_type": "LoadImage", "_meta": {"title": "Primer fotograma"}, "inputs": {"image": "{{IMAGEN_INICIAL}}"}},
  "10": {"class_type": "ImageScale", "inputs": {"image": ["9", 0], "upscale_method": "lanczos", "width": "{{ANCHO}}", "height": "{{ALTO}}", "crop": "center"}},
  "11": {"class_type": "LTXVPreprocess", "inputs": {"image": ["10", 0], "img_compression": 18}},
  "12": {"class_type": "EmptyLTXVLatentVideo", "inputs": {"width": "{{ANCHO_MEDIO}}", "height": "{{ALTO_MEDIO}}", "length": "{{FRAMES}}", "batch_size": 1}},
  "13": {"class_type": "LTXVImgToVideoInplace", "inputs": {"vae": ["3", 0], "image": ["11", 0], "latent": ["12", 0], "strength": 0.7, "bypass": false}},
  "14": {"class_type": "LTXVEmptyLatentAudio", "_si": "!audio_referencia", "inputs": {"audio_vae": ["4", 0], "frames_number": "{{FRAMES}}", "frame_rate": "{{FPS}}", "batch_size": 1}},
  "15": {"class_type": "LoadAudio", "_si": "audio_referencia", "_meta": {"title": "Voz de referencia (TTS)"}, "inputs": {"audio": "{{AUDIO_REFERENCIA}}"}},
  "16": {"class_type": "TrimAudioDuration", "_si": "audio_referencia", "inputs": {"audio": ["15", 0], "start_index": 0.0, "duration": "{{DURACION_SEG}}"}},
  "17": {"class_type": "LTXVAudioVAEEncode", "_si": "audio_referencia", "inputs": {"audio": ["16", 0], "audio_vae": ["4", 0]}},
  "18": {"class_type": "SolidMask", "_si": "audio_referencia", "inputs": {"value": 0.0, "width": "{{ANCHO}}", "height": "{{ALTO}}"}},
  "19": {"class_type": "SetLatentNoiseMask", "_si": "audio_referencia", "inputs": {"samples": ["17", 0], "mask": ["18", 0]}},
  "20": {"class_type": "LTXVConcatAVLatent", "inputs": {"video_latent": ["13", 0], "audio_latent": {"_si": "audio_referencia", "entonces": ["19", 0], "si_no": ["14", 0]}}},
  "21": {"class_type": "RandomNoise", "inputs": {"noise_seed": "{{SEMILLA}}"}},
  "22": {"class_type": "KSamplerSelect", "inputs": {"sampler_name": "euler_ancestral"}},
  "23": {"class_type": "ManualSigmas", "inputs": {"sigmas": "1.0, 0.99375, 0.9875, 0.98125, 0.975, 0.909375, 0.725, 0.421875, 0.0"}},
  "24": {"class_type": "LTXVDualCFGGuider", "inputs": {"model": ["1", 0], "positive": ["8", 0], "negative": ["8", 1], "video_cfg": 1.0, "audio_cfg": 1.0}},
  "25": {"class_type": "SamplerCustomAdvanced", "_meta": {"title": "Etapa 1 (media resolución)"}, "inputs": {"noise": ["21", 0], "guider": ["24", 0], "sampler": ["22", 0], "sigmas": ["23", 0], "latent_image": ["20", 0]}},
  "26": {"class_type": "LTXVSeparateAVLatent", "inputs": {"av_latent": ["25", 0]}},
  "27": {"class_type": "LTXVLatentUpsampler", "inputs": {"samples": ["26", 0], "upscale_model": ["5", 0], "vae": ["3", 0]}},
  "28": {"class_type": "LTXVImgToVideoInplace", "inputs": {"vae": ["3", 0], "image": ["11", 0], "latent": ["27", 0], "strength": 1.0, "bypass": false}},
  "29": {"class_type": "LTXVConcatAVLatent", "inputs": {"video_latent": ["28", 0], "audio_latent": ["26", 1]}},
  "30": {"class_type": "RandomNoise", "inputs": {"noise_seed": 42}},
  "31": {"class_type": "KSamplerSelect", "inputs": {"sampler_name": "euler_ancestral"}},
  "32": {"class_type": "ManualSigmas", "inputs": {"sigmas": "0.85, 0.7250, 0.4219, 0.0"}},
  "33": {"class_type": "LTXVDualCFGGuider", "inputs": {"model": ["1", 0], "positive": ["8", 0], "negative": ["8", 1], "video_cfg": 1.0, "audio_cfg": 1.0}},
  "34": {"class_type": "SamplerCustomAdvanced", "_meta": {"title": "Etapa 2 (resolución completa)"}, "inputs": {"noise": ["30", 0], "guider": ["33", 0], "sampler": ["31", 0], "sigmas": ["32", 0], "latent_image": ["29", 0]}},
  "35": {"class_type": "LTXVSeparateAVLatent", "inputs": {"av_latent": ["34", 0]}},
  "36": {"class_type": "VAEDecodeTiled", "inputs": {"samples": ["35", 0], "vae": ["3", 0], "tile_size": 512, "overlap": 64, "temporal_size": 64, "temporal_overlap": 16}},
  "37": {"class_type": "LTXVAudioVAEDecode", "_si": "generar_audio", "inputs": {"samples": ["35", 1], "audio_vae": ["4", 0]}},
  "38": {"class_type": "CreateVideo", "inputs": {"images": ["36", 0], "audio": ["37", 0], "fps": "{{FPS}}"}},
  "39": {"class_type": "SaveVideo", "inputs": {"video": ["38", 0], "filename_prefix": "{{PREFIJO_SALIDA}}", "format": "mp4", "format.codec": "h264"}}
}
