    "nodos_personalizados": "ninguno (todo nativo de ComfyUI)",
    "modelos": [
      {"archivo": "wan2.2_ti2v_5B_fp16.safetensors", "carpeta": "diffusion_models", "repo": "Comfy-Org/Wan_2.2_ComfyUI_Repackaged", "ruta": "split_files/diffusion_models/wan2.2_ti2v_5B_fp16.safetensors", "gb": 10.0},
      {"archivo": "umt5_xxl_fp8_e4m3fn_scaled.safetensors", "carpeta": "text_encoders", "repo": "Comfy-Org/Wan_2.1_ComfyUI_repackaged", "ruta": "split_files/text_encoders/umt5_xxl_fp8_e4m3fn_scaled.safetensors", "gb": 6.74},
      {"archivo": "wan2.2_vae.safetensors", "carpeta": "vae", "repo": "Comfy-Org/Wan_2.2_ComfyUI_Repackaged", "ruta": "split_files/vae/wan2.2_vae.safetensors", "gb": 1.41}
