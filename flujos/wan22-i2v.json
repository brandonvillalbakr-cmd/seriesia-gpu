  "12": {"class_type": "WanImageToVideo", "inputs": {"positive": ["8", 0], "negative": ["9", 0], "vae": ["10", 0], "start_image": ["11", 0], "width": "{{ANCHO}}", "height": "{{ALTO}}", "length": "{{FRAMES}}", "batch_size": 1}},
  "13": {"class_type": "KSamplerAdvanced", "_meta": {"title": "Pasos 0-2 (ruido alto)"}, "inputs": {"model": ["5", 0], "add_noise": "enable", "noise_seed": "{{SEMILLA}}", "steps": 4, "cfg": 1.0, "sampler_name": "euler", "scheduler": "simple", "positive": ["12", 0], "negative": ["12", 1], "latent_image": ["12", 2], "start_at_step": 0, "end_at_step": 2, "return_with_leftover_noise": "enable"}},
  "14": {"class_type": "KSamplerAdvanced", "_meta": {"title": "Pasos 2-4 (ruido bajo)"}, "inputs": {"model": ["6", 0], "add_noise": "disable", "noise_seed": 0, "steps": 4, "cfg": 1.0, "sampler_name": "euler", "scheduler": "simple", "positive": ["12", 0], "negative": ["12", 1], "latent_image": ["13", 0], "start_at_step": 2, "end_at_step": 10000, "return_with_leftover_noise": "disable"}},
  "15": {"class_type": "VAEDecode", "inputs": {"samples": ["14", 0], "vae": ["10", 0]}},
  "16": {"class_type": "CreateVideo", "inputs": {"images": ["15", 0], "fps": "{{FPS}}"}},
  "17": {"class_type": "SaveVideo", "inputs": {"video": ["16", 0], "filename_prefix": "{{PREFIJO_SALIDA}}", "format": "mp4", "format.codec": "h264"}}
